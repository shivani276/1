import torch
import torch.nn as nn
import torch.optim as optim
import torch.nn.functional as F
import numpy as np
import random
from collections import deque, namedtuple
from typing import Tuple
import matplotlib.pyplot as plt

# --- 1. ENVIRONMENT LOGIC ---

def utility_repositioning(W_idle, E_idle):
    """Calculates a composite utility based on idle time and energy."""
    alpha = 0.2
    W_max, W_min = 1, 0
    E_max, E_min = 1, 0

    # Utility based on idle time (favoring higher idle time)
    if W_idle < W_min:
        U_RW = 1
    elif W_min < W_idle < W_max:
        U_RW = (W_idle - W_min) / (W_max - W_min)
    else:
        U_RW = 0

    # Utility based on idle energy (favoring lower energy usage/decay)
    if E_idle < E_min:
        U_RE = 1
    elif E_min < E_idle < E_max:
        U_RE = (E_max - E_idle) / (E_max - E_min)
    else:
        U_RE = 0

    return alpha * U_RW + (1 - alpha) * U_RE


class Grid:
    def __init__(self, index):
        self.index = index
        self.neighbours = []
        self.vehicles = []


class Vehicle:
    def __init__(self, vid, grid_index):
        self.id = vid
        self.grid_index = grid_index
        self.nextgrid = grid_index
        self.agg_idle_time = random.random()
        self.agg_idle_energy = random.random()
        self.u_rep = utility_repositioning(self.agg_idle_time, self.agg_idle_energy)

    def update(self, new_grid):
        """Update vehicle after repositioning or just time decay."""
        self.grid_index = new_grid
        self.nextgrid = new_grid
        
        # Simulate idle decay over time
        self.agg_idle_time = max(0.01, self.agg_idle_time - 0.05)
        self.agg_idle_energy = max(0.01, self.agg_idle_energy - 0.05)
        self.u_rep = utility_repositioning(self.agg_idle_time, self.agg_idle_energy)


class VehicleRepositionEnv:
    def __init__(self, num_grids: int = 5, num_vehicles: int = 3):
        self.num_grids = num_grids
        self.num_vehicles = num_vehicles
        self.grids = [Grid(i) for i in range(num_grids)]
        self.vehicles = [Vehicle(i, random.randint(0, num_grids - 1))
                         for i in range(num_vehicles)]
        self.timestep = 0
        self.max_timesteps = 100

        self.state_size = num_vehicles * 4 # 4 features per vehicle
        self.action_size = num_vehicles * num_grids # (Vehicle * Target Grid)
        
    def reset(self) -> np.ndarray:
        """Reset simulation at the start of an episode."""
        self.timestep = 0
        for v in self.vehicles:
            v.grid_index = random.randint(0, self.num_grids - 1)
            v.agg_idle_time = random.random()
            v.agg_idle_energy = random.random()
            v.u_rep = utility_repositioning(v.agg_idle_time, v.agg_idle_energy)
        return self._get_state()

    def _get_state(self) -> np.ndarray:
        """Return current environment state as a flat vector."""
        state = []
        for v in self.vehicles:
            state.extend([
                v.grid_index / self.num_grids, 
                v.agg_idle_time, 
                v.agg_idle_energy, 
                v.u_rep
            ])
        return np.array(state, dtype=np.float32)

    def step(self, action: int) -> Tuple[np.ndarray, float, bool, dict]:
        """Takes one RL step based on the integer action."""
        
        vehicle_id = action // self.num_grids
        target_grid = action % self.num_grids
        vehicle_to_move = self.vehicles[vehicle_id]
        
        old_util = vehicle_to_move.u_rep
        vehicle_to_move.update(target_grid)
        
        for v in self.vehicles:
            if v.id != vehicle_id:
                v.update(v.grid_index)

        reward = (vehicle_to_move.u_rep - old_util) * 10.0  # Reward scaling

        self.timestep += 1
        done = self.timestep >= self.max_timesteps
        
        return self._get_state(), reward, done, {}

# --- 2. DQN AGENT LOGIC ---

Experience = namedtuple('Experience', ('state', 'action', 'reward', 'next_state', 'done'))

class ReplayBuffer:
    """Fixed-size buffer for experience tuples."""
    def __init__(self, capacity: int):
        self.buffer = deque(maxlen=capacity)

    def push(self, state, action, reward, next_state, done):
        state = np.array(state, dtype=np.float32)
        next_state = np.array(next_state, dtype=np.float32)
        self.buffer.append(Experience(state, action, reward, next_state, done))

    def sample(self, batch_size: int) -> Experience:
        experiences = random.sample(self.buffer, batch_size)
        states = torch.from_numpy(np.vstack([e.state for e in experiences])).float()
        actions = torch.from_numpy(np.vstack([e.action for e in experiences])).long()
        rewards = torch.from_numpy(np.vstack([e.reward for e in experiences])).float()
        next_states = torch.from_numpy(np.vstack([e.next_state for e in experiences])).float()
        # ✅ Fixed .astype position
        dones = torch.from_numpy(np.vstack([e.done for e in experiences]).astype(np.uint8)).float()
        return Experience(states, actions, rewards, next_states, dones)

    def __len__(self):
        return len(self.buffer)


class QNetwork(nn.Module):
    def __init__(self, state_size, action_size):
        super(QNetwork, self).__init__()
        self.fc1 = nn.Linear(state_size, 128)
        self.fc2 = nn.Linear(128, 128)
        self.fc3 = nn.Linear(128, action_size)

    def forward(self, state):
        x = F.relu(self.fc1(state))
        x = F.relu(self.fc2(x))
        return self.fc3(x)


class DQNAgent:
    def __init__(self, state_size, action_size, lr=5e-4, gamma=0.99, tau=1e-3, buffer_size=100000, batch_size=64):
        self.state_size = state_size
        self.action_size = action_size
        self.gamma = gamma
        self.tau = tau
        self.batch_size = batch_size

        self.qnetwork_local = QNetwork(state_size, action_size)
        self.qnetwork_target = QNetwork(state_size, action_size)
        self.optimizer = optim.Adam(self.qnetwork_local.parameters(), lr=lr)

        self.memory = ReplayBuffer(buffer_size)
        self.qnetwork_target.load_state_dict(self.qnetwork_local.state_dict())

        self.epsilon = 1.0
        self.epsilon_decay = 0.999  # slower decay
        self.epsilon_min = 0.01

    def step(self, state, action, reward, next_state, done):
        self.memory.push(state, action, reward, next_state, done)
        if len(self.memory) > self.batch_size:
            self.learn(self.memory.sample(self.batch_size))

    def act(self, state):
        if random.random() < self.epsilon:
            return random.randint(0, self.action_size - 1)
        state_tensor = torch.from_numpy(state).float().unsqueeze(0)
        self.qnetwork_local.eval()
        with torch.no_grad():
            action_values = self.qnetwork_local(state_tensor)
        self.qnetwork_local.train()
        return np.argmax(action_values.cpu().data.numpy())

    def learn(self, experiences):
        states, actions, rewards, next_states, dones = experiences
        Q_targets_next = self.qnetwork_target(next_states).detach().max(1)[0].unsqueeze(1)
        Q_targets = rewards + (self.gamma * Q_targets_next * (1 - dones))
        Q_expected = self.qnetwork_local(states).gather(1, actions)
        loss = F.mse_loss(Q_expected, Q_targets)

        self.optimizer.zero_grad()
        loss.backward()
        self.optimizer.step()

        self.soft_update(self.qnetwork_local, self.qnetwork_target, self.tau)

    def soft_update(self, local_model, target_model, tau):
        for target_param, local_param in zip(target_model.parameters(), local_model.parameters()):
            target_param.data.copy_(tau * local_param.data + (1 - tau) * target_param.data)

    def update_epsilon(self):
        self.epsilon = max(self.epsilon_min, self.epsilon * self.epsilon_decay)

    def save_model(self, path):
        torch.save(self.qnetwork_local.state_dict(), path)


# --- 3. TRAINING LOOP ---

def dqn_train_loop(env: VehicleRepositionEnv, agent: DQNAgent, num_episodes: int = 200):
    scores_window = deque(maxlen=100)
    all_scores = []

    print("--- Starting DQN Training ---")
    print(f"State Size: {env.state_size}, Action Size: {env.action_size}")
    print("----------------------------------")

    for episode in range(1, num_episodes + 1):
        state = env.reset()
        score = 0
        done = False

        while not done:
            action = agent.act(state)
            next_state, reward, done, _ = env.step(action)
            agent.step(state, action, reward, next_state, done)
            state = next_state
            score += reward

        scores_window.append(score)
        all_scores.append(score)
        agent.update_epsilon()

        print(f"Episode {episode}/{num_episodes} | Score: {score:.2f} | Avg(100): {np.mean(scores_window):.2f} | Eps: {agent.epsilon:.3f}")

    agent.save_model("dqn_repositioning_model.pth")
    print("\nTraining complete! Model saved to dqn_repositioning_model.pth")

    # Plot results
    plt.figure(figsize=(8, 5))
    plt.plot(all_scores, label='Episode Reward')
    plt.xlabel("Episode")
    plt.ylabel("Reward")
    plt.title("DQN Training Performance")
    plt.legend()
    plt.show()


# --- MAIN ---

if __name__ == "__main__":
    env = VehicleRepositionEnv(num_grids=5, num_vehicles=3)
    agent = DQNAgent(state_size=env.state_size, action_size=env.action_size, lr=5e-4)
    try:
        dqn_train_loop(env, agent, num_episodes=200)
    except Exception as e:
        print(f"\nAn error occurred during training: {e}")
