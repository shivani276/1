# ---------------------- STEP 2: Make a square bounding box ----------------------
def square_bounds_from_calls(calls_df, lat_col="lat", lng_col="lng", pad_ratio=0.0):
    if calls_df.empty:
        raise ValueError("calls_df is empty")
    
    lat_min = calls_df[lat_col].min()
    lat_max = calls_df[lat_col].max()
    lng_min = calls_df[lng_col].min()
    lng_max = calls_df[lng_col].max()

    lat_span = lat_max - lat_min
    lng_span = lng_max - lng_min
    side = max(lat_span, lng_span) * (1 + pad_ratio)

    lat_center = (lat_min + lat_max) / 2.0
    lng_center = (lng_min + lng_max) / 2.0

    lat_min_s = lat_center - side / 2.0
    lat_max_s = lat_center + side / 2.0
    lng_min_s = lng_center - side / 2.0
    lng_max_s = lng_center + side / 2.0
    return lat_min_s, lat_max_s, lng_min_s, lng_max_s


# ---------------------- STEP 3: Create grid edges ----------------------
def grid_edges_2d(lat_min, lat_max, lng_min, lng_max, n_rows=5, n_cols=5):
    lat_edges = np.linspace(lat_min, lat_max, n_rows + 1)
    lng_edges = np.linspace(lng_min, lng_max, n_cols + 1)
    return lat_edges, lng_edges


# ---------------------- STEP 4: Draw only the grid ----------------------
def draw_grid(lat_edges, lng_edges, figsize=(6,6), title="Square 5x5 Grid"):
    fig, ax = plt.subplots(figsize=figsize)
    ax.set_xlim(lng_edges[0], lng_edges[-1])
    ax.set_ylim(lat_edges[0], lat_edges[-1])

    # Draw grid lines
    for x in lng_edges:
        ax.axvline(x, color="gray", linewidth=0.8)
    for y in lat_edges:
        ax.axhline(y, color="gray", linewidth=0.8)

    ax.set_xlabel("Longitude")
    ax.set_ylabel("Latitude")
    ax.set_title(title)
    ax.set_aspect("equal", adjustable="box")
    plt.tight_layout()
    plt.show()


