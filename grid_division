def add_lat_lng_from_point(
    df: pd.DataFrame,
    src_col: str = "case_location",
    lat_col: str = "lat",
    lng_col: str = "lng",
    overwrite: bool = True,
    drop_invalid: bool = False
) -> pd.DataFrame:
    """
    Parse WKT POINT strings (format: 'POINT (lng lat)') into numeric lat/lng columns.

    Params:
      df            : DataFrame containing src_col
      src_col       : column with WKT strings, e.g., 'POINT (-122.4046 37.7777)'
      lat_col/lng_col: output column names
      overwrite     : if False and lat/lng already exist, leave them as-is
      drop_invalid  : if True, drop rows where parsing fails; else leave NaN

    Returns:
      New DataFrame with lat_col and lng_col as float columns.
    """
    if src_col not in df.columns:
        raise ValueError(f"Column '{src_col}' not found")

    if not overwrite and (lat_col in df.columns or lng_col in df.columns):
        return df

    # case-insensitive, tolerant to spaces
    pattern = re.compile(r"^\s*POINT\s*\(\s*([-+]?\d*\.?\d+)\s+([-+]?\d*\.?\d+)\s*\)\s*$", re.IGNORECASE)

    def parse_one(val):
        if isinstance(val, str):
            m = pattern.match(val)
            if m:
                lng, lat = m.groups()
                return float(lat), float(lng)
        return (float("nan"), float("nan"))

    out = df.copy()
    out[[lat_col, lng_col]] = out[src_col].apply(lambda v: pd.Series(parse_one(v)))

    if drop_invalid:
        out = out.dropna(subset=[lat_col, lng_col])

    return out


# If lat/lng aren't present but a WKT point column exists, try to parse it
