
import pandas as pd
import numpy as np
import seaborn as sns
import matplotlib.pyplot as plt

def generate_combined_calls(
    calls_df, 
    timestamp_col, 
    lat_col, 
    lng_col, 
    grids_lat=4, 
    grids_lng=4, 
    avg_speed_kmh=60.0
):
   
    # --- 1. CALCULATE ACTUAL 5x5 COUNTS ---
    if calls_df.empty:
        print("DataFrame is empty. Cannot perform analysis.")
        return

    lat_min, lat_max = calls_df[lat_col].min(), calls_df[lat_col].max()
    lng_min, lng_max = calls_df[lng_col].min(), calls_df[lng_col].max()
    lat_step = (lat_max - lat_min) / grids_lat
    lng_step = (lng_max - lng_min) / grids_lng
    latitude_divisions = [lat_min + i * lat_step for i in range(grids_lat + 1)]
    longitude_divisions = [lng_min + i * lng_step for i in range(grids_lng + 1)]
    C_ij = np.zeros((grids_lat, grids_lng)) 
    cell_data_pools = {}

    for i in range(grids_lat):
        lat_start, lat_end = latitude_divisions[i], latitude_divisions[i+1]
        for j in range(grids_lng):
            lng_start, lng_end = longitude_divisions[j], longitude_divisions[j+1]
            lat_filter = (calls_df[lat_col] >= lat_start) & (calls_df[lat_col] <= lat_end if i == grids_lat - 1 else calls_df[lat_col] < lat_end)
            lng_filter = (calls_df[lng_col] >= lng_start) & (calls_df[lng_col] <= lng_end if j == grids_lng - 1 else calls_df[lng_col] < lng_end)
            cell_calls = calls_df[lat_filter & lng_filter]
            C_ij[i, j] = len(cell_calls)
            
            if not cell_calls.empty:
                cell_data_pools[(i, j)] = cell_calls
            else:
                cell_data_pools[(i, j)] = calls_df

    # --- 1.5. CALCULATE TIMESLOT DURATION ---
    lat_centers = [ (latitude_divisions[i] + latitude_divisions[i+1]) / 2 for i in range(grids_lat) ]
    lng_centers = [ (longitude_divisions[j] + longitude_divisions[j+1]) / 2 for j in range(grids_lng) ]
    timeslot_distance_deg = ((lat_centers[0] - lat_centers[0])**2 + (lng_centers[1] - lng_centers[0])**2)**0.5
    distance_km = timeslot_distance_deg * 111
    
    print(f"\nGrid cell Width (approx): {distance_km:.3f} km")
    
    if avg_speed_kmh <= 0:
        time_minutes = 15.0
    else:
        time_hours = distance_km / avg_speed_kmh
        time_minutes = time_hours * 60
        print(f"Using average speed: {avg_speed_kmh} km/h")
        print(f"CALCULATED travel time / timeslot duration: {time_minutes:.2f} minutes")
    
    # --- 0. PRE-PROCESSING (Build Temporal Profile) ---
    calls_df[timestamp_col] = pd.to_datetime(calls_df[timestamp_col], errors='coerce')
    calls_df.dropna(subset=[timestamp_col], inplace=True)
    
    total_minutes_in_day = 24 * 60
    if time_minutes < 1: 
        time_minutes = 1.0
        
    num_slots_per_day = int(np.ceil(total_minutes_in_day / time_minutes))
    num_days_to_simulate = 365
    num_slots_total = num_slots_per_day * num_days_to_simulate
    
    print(f"Calculated {num_slots_per_day} timeslots of {time_minutes:.2f} minutes each for a 24h period.")
    print(f"Simulating {num_days_to_simulate} days for a total of {num_slots_total} timeslots.")

    # --- Create the Temporal Profile (for an average day) ---
    calls_df['minute_of_day'] = calls_df[timestamp_col].dt.hour * 60 + calls_df[timestamp_col].dt.minute
    calls_df['timeslot_index'] = (calls_df['minute_of_day'] // time_minutes).astype(int)
    calls_per_slot = calls_df.groupby('timeslot_index').size()
    calls_per_slot = calls_per_slot.reindex(range(num_slots_per_day), fill_value=0)
    total_calls_in_sample = calls_per_slot.sum()
    
    if total_calls_in_sample > 0:
        temporal_profile = calls_per_slot / total_calls_in_sample
    else:
        print("No calls in sample to build temporal profile.")
        return

    # --- 2. CALCULATE SPATIAL EXPECTATION (LAMBDA) ---
    MODEL_WEIGHT = 0.5 
    #print(f"\n--- Using a BLENDED Model for simulation mean (lambda) ---")
    print(f"Blend: {MODEL_WEIGHT*100}% Smooth Model + {(1-MODEL_WEIGHT)*100}% Actual Data")

    mu_rows = C_ij.mean(axis=1)
    mu_cols = C_ij.mean(axis=0)
    mu_grand = C_ij.mean()
    
    lambda_ij = np.zeros((grids_lat, grids_lng))
    
    for i in range(grids_lat):
        for j in range(grids_lng):
        
            # --- THIS IS THE FIX ---
            # We now get the model_val, but clamp it at 0.
            # This stops the negative smooth model from "poisoning" the actual data.
            model_val = max(0, mu_rows[i] + mu_cols[j] - mu_grand)
            # --- END OF THE FIX ---

            actual_val = C_ij[i, j]
            
            blended_val = (MODEL_WEIGHT * model_val) + ((1 - MODEL_WEIGHT) * actual_val)
            
            lambda_ij[i, j] = max(0, blended_val) # This max(0,...) is still a good safeguard

    if lambda_ij.sum() > 0:
        lambda_total = lambda_ij.sum()
        actual_total = C_ij.sum()
        # Scale the blended model to have the same total as the actual data
        lambda_ij = (lambda_ij / lambda_total) * actual_total
    
    # --- 3. GENERATE FINAL SIMULATED COUNTS (Spatio-Temporal) ---
    generated_calls_list = []
    intermediate_cols = ['minute_of_day', 'timeslot_index']
    simulated_cols = [lat_col, lng_col, timestamp_col]
    cols_to_ignore = set(intermediate_cols + simulated_cols)
    other_cols_to_sample = [col for col in calls_df.columns if col not in cols_to_ignore]
    
    #print(f"Will sample the following columns: {other_cols_to_sample}")

    # Calculate the average *daily* expected calls per cell
    lambda_ij_daily = lambda_ij / 365.0
    
    #print("\nStarting 1-year (365 day) simulation...")
    
    sim_base_date = pd.to_datetime('2025-01-01')
    
    Total_Simulated_C_ij = np.zeros((grids_lat, grids_lng))
    Peak_Calls_In_One_Slot = 0
    Total_Simulated_Calls = 0

    # Loop over every timeslot of the *entire year*
    for t in range(num_slots_total):
        
        current_slot_of_day = t % num_slots_per_day
        time_multiplier = temporal_profile.iloc[current_slot_of_day]
        mean_ij_for_slot = lambda_ij_daily * time_multiplier
        
        # Use Poisson distribution
        simulated_counts_t = np.random.poisson(lam=mean_ij_for_slot)
        
        # Keep track of totals
        Total_Simulated_C_ij += simulated_counts_t
        slot_total_calls = simulated_counts_t.sum()
        if slot_total_calls > Peak_Calls_In_One_Slot:
            Peak_Calls_In_One_Slot = slot_total_calls
        Total_Simulated_Calls += slot_total_calls

        # --- "Disaggregate" counts into individual rows ---
        slot_start_minute_of_year = t * time_minutes
        slot_end_minute_of_year = (t + 1) * time_minutes
        
        for i in range(grids_lat):
            for j in range(grids_lng):
                num_calls_to_gen = simulated_counts_t[i, j]
                
                if num_calls_to_gen > 0:
                    
                    # 1. Generate Timestamps
                    sim_minutes = np.random.uniform(slot_start_minute_of_year, slot_end_minute_of_year, num_calls_to_gen)
                    sim_timestamps = [sim_base_date + pd.to_timedelta(m, 'm') for m in sim_minutes]
                    
                    # 2. Generate Coordinates
                    lat_start, lat_end = latitude_divisions[i], latitude_divisions[i+1]
                    lng_start, lng_end = longitude_divisions[j], longitude_divisions[j+1]
                    sim_lats = np.random.uniform(lat_start, lat_end, num_calls_to_gen)
                    sim_lngs = np.random.uniform(lng_start, lng_end, num_calls_to_gen)
                    
                    # 3. Sample "Other Columns"
                    pool = cell_data_pools.get((i, j), calls_df)
                    if pool.empty: pool = calls_df
                    sampled_rows = pool.sample(n=num_calls_to_gen, replace=True)
                    
                    # 4. Combine
                    new_calls_df = pd.DataFrame({
                        timestamp_col: sim_timestamps,
                        lat_col: sim_lats,
                        lng_col: sim_lngs
                    })
                    
                    sampled_rows = sampled_rows[other_cols_to_sample].reset_index(drop=True)
                    new_calls_df = new_calls_df.reset_index(drop=True)
                    final_new_rows = pd.concat([new_calls_df, sampled_rows], axis=1)
                    generated_calls_list.append(final_new_rows)

    print(f"...Simulation complete. Generated {Total_Simulated_Calls} total calls.")

    # --- 4. CALCULATE TOTALS ---
    if generated_calls_list:
        Final_Simulated_Data = pd.concat(generated_calls_list, ignore_index=True)
        Final_Simulated_Data.sort_values(timestamp_col, inplace=True)
    else:
        Final_Simulated_Data = pd.DataFrame(columns=calls_df.columns) # Empty df

    Total_Simulated_C_ij = Total_Simulated_C_ij.astype(int)
    
    # --- 5. PLACE AMBULANCES ---
    # Using the logic of 80% of Average Daily Calls
    total_daily_calls = Total_Simulated_Calls / num_days_to_simulate 
    ambulance_locations = np.zeros((grids_lat, grids_lng), dtype=int)
    num_ambulances = 0
    
    print(f"\n--- Ambulance Deployment ---")
    
    if Total_Simulated_Calls > 0:
        
        peak_calls_in_one_slot = int(Peak_Calls_In_One_Slot)

        # Base fleet size on 80% of AVERAGE DAILY CALLS
        num_ambulances = int(np.round(total_daily_calls * 0.80))
        
        print(f"Total simulated yearly calls: {Total_Simulated_Calls}")
        print(f"Average simulated daily calls: {total_daily_calls:.2f}")
        print(f"Busiest (peak) timeslot had: {peak_calls_in_one_slot} calls")
        print(f"Deploying {num_ambulances} ambulances (80% of AVERAGE DAILY calls).")

        # Distribute ambulances based on the *yearly* expected model (lambda_ij)
        if lambda_ij.sum() > 0:
            call_proportions_matrix = lambda_ij / lambda_ij.sum()
            flat_proportions = call_proportions_matrix.flatten()
            cell_indices = np.arange(grids_lat * grids_lng)
            
            chosen_indices = np.random.choice(
                cell_indices, 
                size=num_ambulances, 
                p=flat_proportions, 
                replace=True
            )
            
            for idx in chosen_indices:
                i, j = np.unravel_index(idx, (grids_lat, grids_lng))
                ambulance_locations[i, j] += 1
        else:
            print("Cannot deploy ambulances: Expected call model (lambda_ij) is zero.")
            
    else:
        print("No calls generated, so no ambulances deployed.")


    
    # --- 6. OUTPUT RESULTS ---
    print(f"\n--- Final {grids_lat}x{grids_lng} Combined Simulation (All as Daily Averages, Rounded) ---")
    
    # mu_grand is the mean-per-cell for the *year*. Divide by 365 for daily.
    #print(f"Grand Mean (Average Daily Calls per Cell): {mu_grand / num_days_to_simulate:.0f}")

    print(f"\nActual Call Counts Matrix (Average Daily from 1-year sample):")
    # Divide the yearly C_ij matrix by the number of days
    print(pd.DataFrame(C_ij / num_days_to_simulate, index=[f'Row {i+1} (Lat)' for i in range(grids_lat)],columns=[f'Col {j+1} (Lng)' for j in range(grids_lng)]).to_string(float_format="%.0f"))

    print("\nExpected Lambda (Blended Model - Average Daily):")
    # Divide the yearly lambda_ij matrix by the number of days
    print(pd.DataFrame(lambda_ij / num_days_to_simulate,index=[f'Row {i+1} (Lat)'for i in range(grids_lat)],columns=[f'Col {j+1} (Lng)' for j in range(grids_lng)]).to_string(float_format="%.0f"))

    print(f"\nTarget Simulated Call Counts Matrix (Average Daily over {num_days_to_simulate} days):")
    # Divide the simulated yearly total matrix by the number of days
    print(pd.DataFrame(Total_Simulated_C_ij / num_days_to_simulate,index=[f'Row {i+1} (Lat)' for i in range(grids_lat)],columns=[f'Col {j+1} (Lng)' for j in range(grids_lng)]).to_string(float_format="%.0f"))

    print("\nAmbulance Deployment Matrix (This is a total, not an average):")
    # This matrix is NOT a rate, so we don't divide it.
    print(pd.DataFrame( ambulance_locations,index=[f'Row {i+1} (Lat)' for i in range(grids_lat)],columns=[f'Col {j+1} (Lng)' for j in range(grids_lng)]).to_string())

    #print(f"\n--- Example Timeslot Snapshots (Simulated Counts) ---")
    #print("(Snapshots are disabled for 1-year simulation to save memory)")

    print("\n--- Final Generated Call-by-Call DataFrame ---")
    print(f"Generated a total of {len(Final_Simulated_Data)} individual simulated calls.")
    print("Head of generated data (from start of year):")
    print(Final_Simulated_Data.head(10).to_string())
    #print("\nTail of generated data (from end of year):")
    #print(Final_Simulated_Data.tail(10).to_string())

